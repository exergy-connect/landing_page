      "include": [
        "bgp/*.{yml,yaml}",
        "evpn/*.{yml,yaml}",
        "evpn.multihoming/*.{yml,yaml}",
        "gateway/*.{yml,yaml}",
        "isis/*.{yml,yaml}",
        "ospf/*/*.{yml,yaml}",
        "vlan/*.{yml,yaml}",
        "vxlan/*.{yml,yaml}"
      ]
    }
  ]
}

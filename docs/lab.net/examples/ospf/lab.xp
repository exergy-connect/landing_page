---
id: "ospf"
title: "OSPF IPv4"
summary: "Single-area OSPF routing between two routers with passive client subnets and host-to-host ICMP."
eyebrow: "EXERGY-LAB.NET LAB 12"
headline: "OSPF with client ping"

# Single-area IPv4 OSPF: passive host subnets, numbered router adjacency.
# C/WASM handles packets, database exchange, flooding, SPF, and protocol timers.

_id: ospf

topology:
  _concept: topology
  device: frr
  module: [ospf]
  name: ospf

  nodes:
    r1:
      device: frr
    r2:
      device: frr
    client1:
      device: linux
      role: host
      validation:
        actions:
          - label: ping client2
            type: ping
            target: client2.ipv4
            count: 3
    client2:
      device: linux
      role: host

  links:
    - interfaces:
        - node: client1
        - node: r1
      type: p2p
    - interfaces:
        - node: r1
        - node: r2
      type: p2p
    - interfaces:
        - node: r2
        - node: client2
      type: p2p

  validate:
    - label: r1 has both client subnets
      state:
        - node: r1
          routes:
            - prefix: client1.prefix
              protocol: connected
            - prefix: client2.prefix
              protocol: ospf
              nexthop: r2.ipv4.r1
    - label: r2 has both client subnets
      state:
        - node: r2
          routes:
            - prefix: client2.prefix
              protocol: connected
            - prefix: client1.prefix
              protocol: ospf
              nexthop: r1.ipv4.r2
    - label: hosts have a default toward their router
      state:
        - node: client1
          routes:
            - prefix: 0.0.0.0/0
              protocol: static
              nexthop: r1.ipv4.client1
        - node: client2
          routes:
            - prefix: 0.0.0.0/0
              protocol: static
              nexthop: r2.ipv4.client2
    - label: client1 reaches client2
      packet:
        from: client1
        type: icmp-echo
        target: client2.ipv4
        expect:
          type: icmp-echo-reply
          from: client2
---

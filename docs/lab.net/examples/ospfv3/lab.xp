---
id: "ospfv3"
title: "OSPFv3 IPv6"
summary: "Single-area IPv6 routing with OSPFv3, link-local next hops, and client-to-client ICMPv6."
headline: "OSPFv3 with IPv6 client ping"

# Single-area IPv6 OSPFv3: passive host subnets, numbered router adjacency.
# C/WASM handles packets, database exchange, flooding, SPF, and protocol timers.


addressing:
  p2p: { ipv4: false, ipv6: '2001:db8:2::/48', prefix6: 64 }
  lan: { ipv4: false, ipv6: '2001:db8:1::/48', prefix6: 64 }

topology:
  device: frr
  module: [ospf]
  name: ospfv3

  nodes:
    r1:
      device: frr
      ospf:
        router_id: 10.255.0.1
    r2:
      device: frr
      ospf:
        router_id: 10.255.0.2
    client1:
      device: linux
      role: host
      validation:
        actions:
          - label: ping client2
            type: ping
            target: client2.ipv6
            count: 3
    client2:
      device: linux
      role: host

  links:
    - interfaces:
        - node: client1
        - node: r1
      type: p2p
    - interfaces:
        - node: r1
        - node: r2
      type: p2p
    - interfaces:
        - node: r2
        - node: client2
      type: p2p

  validate:
    - label: r1 has both client subnets
      state:
        - node: r1
          routes:
            - prefix: client1.prefix
              protocol: connected
            - prefix: client2.prefix
              protocol: ospfv3
    - label: r2 has both client subnets
      state:
        - node: r2
          routes:
            - prefix: client2.prefix
              protocol: connected
            - prefix: client1.prefix
              protocol: ospfv3
    - label: hosts have a default toward their router
      state:
        - node: client1
          routes:
            - prefix: ::/0
              protocol: static
              nexthop: r1.ipv6.client1
        - node: client2
          routes:
            - prefix: ::/0
              protocol: static
              nexthop: r2.ipv6.client2
    - label: client1 reaches client2
      packet:
        from: client1
        type: icmp-echo
        target: client2.ipv6
        expect:
          type: icmp-echo-reply
          from: client2
---

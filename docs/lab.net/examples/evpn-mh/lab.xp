---
id: "evpn-mh"
title: "EVPN multihoming"
summary: "h1 bonds its links to r1 and r2 in one all-active Ethernet Segment. Disable either host uplink to test failover; r3 connects the remote host."
eyebrow: "EXERGY-LAB.NET LAB 11"
headline: "EVPN multihoming with host LAG"

_id: evpn-mh
# h1 bonds two access links to different VTEPs in the same Ethernet Segment.
# h2 is single-homed on r3. Disable either h1 uplink to exercise failover.
topology:
  name: evpn-mh
  device: frr
  module: [vlan, vxlan, bgp, evpn]
  vxlan:
    flooding: evpn
  vlans:
    blue:
      id: 10
      mode: bridge
      vni: 10010
      prefix:
        ipv4: 192.168.10.0/24
  nodes:
    h1:
      device: linux
      role: host
      bonds:
        bond0:
          members: [eth1, eth2]
          mode: 802.3ad
      validation:
        actions:
          - label: ping h2
            type: ping
            target: 192.168.10.11
    h2:
      device: linux
      role: host
    r1:
      bgp:
        as: 65000
      vxlan:
        vtep: 10.1.1.1
      bonds:
        bond0:
          members: [eth1]
          esi: 00:00:00:00:00:00:00:00:00:01
          df_preference: 40000
    r2:
      routing:
        static:
          - ipv4: 10.1.2.2/32
            nexthop: 10.1.3.2
      bgp:
        as: 65000
      vxlan:
        vtep: 10.1.1.2
      bonds:
        bond0:
          members: [eth1]
          esi: 00:00:00:00:00:00:00:00:00:01
    r3:
      routing:
        static:
          - ipv4: 10.1.1.1/32
            nexthop: 10.1.2.1
          - ipv4: 10.1.1.2/32
            nexthop: 10.1.3.1
      bgp:
        as: 65000
      vxlan:
        vtep: 10.1.2.2
  links:
    - vlan.access: blue
      interfaces:
        - node: h1
          ifname: eth1
          ipv4: 192.168.10.10/24
        - node: r1
          ifname: eth1
    - vlan.access: blue
      interfaces:
        - node: h1
          ifname: eth2
        - node: r2
          ifname: eth1
    - vlan.access: blue
      interfaces:
        - node: h2
          ifname: eth1
          ipv4: 192.168.10.11/24
        - node: r3
          ifname: eth1
    - interfaces:
        - node: r1
          ifname: eth2
          ipv4: 10.1.1.1/30
        - node: r2
          ifname: eth2
          ipv4: 10.1.1.2/30
      prefix:
        ipv4: 10.1.1.0/30
    - interfaces:
        - node: r1
          ifname: eth3
          ipv4: 10.1.2.1/30
        - node: r3
          ifname: eth2
          ipv4: 10.1.2.2/30
      prefix:
        ipv4: 10.1.2.0/30
    - interfaces:
        - node: r2
          ifname: eth3
          ipv4: 10.1.3.1/30
        - node: r3
          ifname: eth3
          ipv4: 10.1.3.2/30
      prefix:
        ipv4: 10.1.3.0/30
  validate:
    - label: Bonded host reaches remote host
      packet:
        type: icmp-echo
        from: h1
        target: 192.168.10.11
        expect:
          type: icmp-echo-reply
          from: h2
---

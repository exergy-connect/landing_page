---
id: "ebgp-icmp-bfd"
title: "Multihop iBGP with BFD"
summary: "Four routers in a line; inferred r1–r4 iBGP with BFD detects failure of the remote r2–r3 link."
eyebrow: "EXERGY-LAB.NET LAB 02"
headline: "Remote link failure with iBGP and BFD"

# client1 -- r1 -- r2 -- r3 -- r4 -- client2
# OSPF provides transit and loopback reachability across the four routers.
# Only r1 and r4 run BGP, in AS 65001: their iBGP session is inferred.
# BFD is enabled only for that multihop iBGP session, not for OSPF.
# Bring down r2--r3: neither BGP endpoint sees a local carrier-down event.
# Inspect r1/r4 BFD and BGP state as the remote path fails.
# Matching 100 ms intervals and multiplier 3 give 300 ms BFD detection once Up.


topology:
  device: frr
  module: [ospf]
  bfd: { min_tx: 100, min_rx: 100, multiplier: 3 }
  name: ebgp-icmp-bfd
  layout: grid

  nodes:
    r1:
      layout.grid: B1
      device: frr
      module: [ospf, bgp, bfd]
      bgp:
        as: 65001
        bfd: true
    r2:
      layout.grid: B2
      device: frr
      module: [ospf]
    r3:
      layout.grid: C2
      device: frr
      module: [ospf]
    r4:
      layout.grid: C1
      device: frr
      module: [ospf, bgp, bfd]
      bgp:
        as: 65001
        bfd: true
    client1:
      layout.grid: A1
      device: linux
      role: host
      validation:
        actions:
          - label: ping client2
            type: ping
            target: client2
            count: 3
          - label: MRC write to client2
            type: mrc
            role: sender
            target: client2
            qp: 1
            bytes: 1048576
            paths: 8
            packetBytes: 4096
            rateBps: 100000000000
            congestionControl: nscc
            ecn: true
            ecnThresholdBytes: 262144
    client2:
      layout.grid: D1
      device: linux
      role: host
      validation:
        actions:
          - type: mrc
            role: receiver
            qp: 1
            bufferBytes: 67108864

  links: [ client1-r1, r1-r2, r2-r3, r3-r4, r4-client2 ]

  # Steps run in order. A step is either device state that must already hold,
  # or a packet to send plus the response that must come back.
  # ASN, prefix, address, and nexthop values can name a node instead of a
  # literal, so the checks follow the lab if its addressing changes:
  # r4.asn, client1.prefix, client2.ipv4, r1.ipv4.client1.
  validate:
    - label: inferred multihop iBGP session is up
      state:
        - node: r1
          bgp:
            - peer: r4
              asn: r4.asn
              state: established
        - node: r4
          bgp:
            - peer: r1
              asn: r1.asn
              state: established
    - label: r1 has both client subnets
      state:
        - node: r1
          routes:
            - prefix: client1.prefix
              protocol: connected
            - prefix: client2.prefix
              protocol: ospf
              nexthop: r2.ipv4.r1
    - label: r4 has both client subnets
      state:
        - node: r4
          routes:
            - prefix: client2.prefix
              protocol: connected
            - prefix: client1.prefix
              protocol: ospf
              nexthop: r3.ipv4.r4
    - label: hosts have a default toward their router
      state:
        - node: client1
          routes:
            - prefix: 0.0.0.0/0
              protocol: static
              nexthop: r1.ipv4.client1
        - node: client2
          routes:
            - prefix: 0.0.0.0/0
              protocol: static
              nexthop: r4.ipv4.client2
    - label: client1 reaches client2
      packet:
        from: client1
        type: icmp-echo
        target: client2.ipv4
        expect:
          type: icmp-echo-reply
          from: client2
    - label: client1 completes an MRC RDMA Write
      mrc:
        sender: client1
        receiver: client2
        qp: 1
        bytes: 1048576
        paths: 8
        congestionControl: nscc
        ecn: true
        expect:
          minPaths: 1
          maxRetransmissions: 0
          maxEcnMarkedPackets: 0
---
